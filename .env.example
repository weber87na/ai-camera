# OpenAI API 金鑰
OPENAI_API_KEY=

# XAI_API_KEY 金鑰
XAI_API_KEY=

# 照片轉影片設定：修改設定值後須重新啟動伺服器；影片比例沿用原照片
# 是否啟用：true 啟用；false 僅生成照片。啟用前須設定 XAI_API_KEY
VIDEO_ENABLED=false

# xAI 影片生成模型名稱，預設使用 grok-imagine-video-1.5-lite
VIDEO_MODEL=grok-imagine-video-1.5-lite

# 影片長度（秒）：可設定 1–15，預設 3 秒
VIDEO_DURATION=3

# 影片解析度：480p、720p 或 1080p，須為所選模型支援的解析度
VIDEO_RESOLUTION=720p

# 是否生成聲音：false 生成無聲影片（預設）；true 生成含聲音影片
VIDEO_GENERATE_AUDIO=false

# 影片生成最長等待時間（毫秒）：600000 = 10 分鐘；逾時保留已生成的照片
VIDEO_TIMEOUT_MS=600000

# 查詢影片生成進度的間隔（毫秒）：5000 = 5 秒，須小於最長等待時間
VIDEO_POLL_INTERVAL_MS=5000

# xAI API 基礎網址：一般使用官方網址即可；本機測試可改為 localhost API
XAI_BASE_URL=https://api.x.ai/v1

# 伺服器監聽的連接埠
PORT=3000

# 拍照模式：standard（原有十種風格，預設）或 opera（歌仔戲：生、旦、淨、丑）
# 也接受 PHOTO_MODE=歌仔戲；修改後須重新啟動伺服器
PHOTO_MODE=standard

# 最大同時處理的生成工作數
MAX_CONCURRENT=3

# 最大排隊等候數量
MAX_QUEUE=30

# 美元兌新台幣匯率（用於估算成本）
USD_TO_TWD=32.5

# gpt-image-2.5-flare 官方價格（2026-09-09）
# https://developers.openai.com/api/docs/pricing
# 文字輸入每百萬 token 的美元費用
TEXT_INPUT_USD_PER_MILLION=5

# 圖片輸入每百萬 token 的美元費用
IMAGE_INPUT_USD_PER_MILLION=8

# 圖片輸出每百萬 token 的美元費用
IMAGE_OUTPUT_USD_PER_MILLION=30

# 官方快取輸入價格：文字 $1.25、圖片 $2 / 百萬 tokens。
# Images API 未提供已文件化的快取分類明細，成本先以一般輸入費率估算。

# 圖片生成品質（low, medium, high, xhigh, max, auto；預設 high）
IMAGE_QUALITY=high

# 儲存生成圖片的目錄（預設：./storage）
STORAGE_DIR=./storage
