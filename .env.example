# OpenAI API 金鑰
OPENAI_API_KEY=

# 伺服器監聽的連接埠
PORT=3000

# 最大同時處理的生成工作數
MAX_CONCURRENT=3

# 最大排隊等候數量
MAX_QUEUE=30

# 美元兌新台幣匯率（用於估算成本）
USD_TO_TWD=32.5

# 文字輸入每百萬 token 的美元費用
TEXT_INPUT_USD_PER_MILLION=5

# 圖片輸入每百萬 token 的美元費用
IMAGE_INPUT_USD_PER_MILLION=8

# 圖片輸出每百萬 token 的美元費用
IMAGE_OUTPUT_USD_PER_MILLION=30

# 圖片生成品質（可選值：low, medium, high，預設為 low）
IMAGE_QUALITY=low

# 儲存生成圖片的目錄（預設：./storage）
STORAGE_DIR=./storage
